# ==============================================================================
# MPLADS Sentinel (e-drishti) — Production Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# Server binding
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2

# Security Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_A_RANDOM_32_CHAR_SECRET

# ------------------------------------------------------------------------------
# 2. Database — Neon Serverless PostgreSQL (neon.tech)
# ------------------------------------------------------------------------------
# Get your connection string from Neon Console → Connection Details
# Format: postgresql://USER:PASSWORD@ENDPOINT.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection pool settings (tune based on your Neon plan)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Set to "true" to force re-seed database on startup (only needed once, then set to false)
AUTO_SEED=false

# ------------------------------------------------------------------------------
# 3. CORS — Allowed Frontend Origins
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
# Replace with your actual Vercel frontend URL.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:8443

# ------------------------------------------------------------------------------
# 4. Logging & Storage
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=data/uploads

# ------------------------------------------------------------------------------
# 5. Frontend (Vercel)
# ------------------------------------------------------------------------------
# If frontend is deployed on Vercel WITH proxy rewrites in vercel.json,
# leave this EMPTY — relative /api/* paths will be proxied automatically.
#
# If frontend is served from a different domain WITHOUT a proxy, set this
# to your Render backend URL:
# VITE_API_BASE_URL=https://mplads-sentinel-api.onrender.com
VITE_API_BASE_URL=
